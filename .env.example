# Supabase project credentials (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used by edge functions and admin scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email delivery for notification emails (supabase/functions/send-notification-emails)
RESEND_API_KEY=

# Zoom webhook verification (supabase/functions/process-zoom-webhooks)
ZOOM_WEBHOOK_SECRET_TOKEN=
